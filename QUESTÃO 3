
int main() {

    float nota, soma = 0, media;
    int alerta;

    for(int i = 1; i <= 10; i++) {
        printf("Digite a nota %d: ", i);
        scanf("%f", &nota);

        soma += nota;
    }

    media = soma / 10;

    printf("Media: %.2f\n", media);

    alerta = (media < 7);

    switch(alerta) {
        case 1:
            printf("Alerta! Media abaixo de 7.\n");
            break;

        case 0:
            printf("Media satisfatoria.\n");
            break;
    }

    return 0;
